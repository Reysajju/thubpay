# Database Configuration
# Local SQLite: file:./dev.db
# Production / Vercel: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require (Neon / Supabase / Postgres)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Run: openssl rand -base64 32 to generate a strong secret
NEXTAUTH_SECRET="thubpay-production-secret-key-must-be-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Gateway Encryption Key (optional, defaults to NEXTAUTH_SECRET)
GATEWAY_ENCRYPTION_KEY="thubpay-encryption-secret-key-at-least-32-chars"

# Optional Email / SMTP Configuration
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# EMAIL_FROM="ThubPay <no-reply@thubpay.com>"
